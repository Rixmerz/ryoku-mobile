<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Normal permission: the bar reads wifi/cellular state for its own network glyph. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Normal permission: lets the app menu hand an uninstall to the system's own confirm dialog. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Normal permission: swipe down on the home screen opens the notification shade. -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />
    <!-- Loopback only: the desktop link dials 127.0.0.1, tunnelled to the computer over USB. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Never granted at install: Shizuku grants these once (pm grant / appops) and they persist. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
        xmlns:tools="http://schemas.android.com/tools" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        xmlns:tools="http://schemas.android.com/tools" tools:ignore="ProtectedPermissions" />

    <!-- Package visibility (API 30+): only apps with a launcher entry, not QUERY_ALL_PACKAGES,
         which Play restricts. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:label="Ryoku Mobile"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Ryoku">
        <!-- singleTask + HOME category makes this selectable as the default launcher. -->
        <activity
            android:name=".LauncherActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".MediaListener"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Shizuku hands its binder to the app through this provider. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>
</manifest>
